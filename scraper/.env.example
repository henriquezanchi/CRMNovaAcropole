# Copie este arquivo para ".env" (no mesmo diretório scraper/) e preencha
# os valores reais — o ".env" nunca é commitado (já está no .gitignore da
# raiz do projeto). Usado só pelo modo local/assistido (ulisses-local.js);
# no GitHub Actions essas mesmas 3 variáveis vêm dos Secrets do
# repositório, não deste arquivo.

# URL do projeto Supabase (painel do Supabase > Project Settings > API).
SUPABASE_URL=

# Chave "service_role" do Supabase (painel > Project Settings > API —
# NUNCA a chave publishable/anon). Dá acesso total, sem RLS — trate como
# senha de root.
SUPABASE_SERVICE_ROLE_KEY=

# A mesma passphrase configurada como secret CREDENCIAIS_SCRAPER_CHAVE
# tanto na Edge Function gerenciar-credenciais (Supabase) quanto nos
# Secrets do GitHub Actions.
CREDENCIAIS_SCRAPER_CHAVE=

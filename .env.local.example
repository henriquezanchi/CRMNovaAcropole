# Copie este arquivo para ".env.local" (mesma pasta, raiz do projeto) e
# preencha os valores reais — ".env.local" nunca é commitado (já está no
# .gitignore da raiz).

# Chave da API externa do Mercury (v2 do Mercúrio), emitida por um
# administrador do Mercury — formato "mrc_...". Escopos pedidos:
# people.read, people.pii, economy.read, staff.read, catalog.read.
MERCURY_API_KEY=

# Endereço base da API (produção, Railway) — nunca localhost:3000.
MERCURY_API_BASE_URL=https://sincere-passion-production-416b.up.railway.app/external/v1

# Banco do Mercúrio (cópia de consulta, atualizada diariamente).
# Acesso pelo phpMyAdmin. Login e senha da TELA do phpMyAdmin.
MERCURIO_DB_PHPMYADMIN_URL=https://mercurio.oinabn.com.br/phpmyadmin
MERCURIO_DB_USUARIO=
MERCURIO_DB_SENHA=
# Se o navegador abrir antes uma janelinha cinza pedindo usuário/senha
# (autenticação do servidor, igual ao Mercúrio antigo), preencha aqui também.
MERCURIO_DB_HTTP_USUARIO=
MERCURIO_DB_HTTP_SENHA=
# Só se o responsável liberar conexão DIRETA ao MySQL (fora do phpMyAdmin).
MERCURIO_DB_HOST=
MERCURIO_DB_PORTA=3306
MERCURIO_DB_NOME=

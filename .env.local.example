# Copie este arquivo para ".env.local" (mesma pasta, raiz do projeto) e
# preencha os valores reais — ".env.local" nunca é commitado (já está no
# .gitignore da raiz).

# Chave da API externa do Mercury (v2 do Mercúrio), emitida por um
# administrador do Mercury — formato "mrc_...". Escopos pedidos:
# people.read, people.pii, economy.read, staff.read, catalog.read.
MERCURY_API_KEY=

# Endereço base da API (produção, Railway) — nunca localhost:3000.
MERCURY_API_BASE_URL=https://sincere-passion-production-416b.up.railway.app/external/v1

{
  "redirects": [
    {
      "source": "/:caminho*",
      "has": [
        {
          "type": "host",
          "value": "crm-nova-acropole-5dv3.vercel.app"
        }
      ],
      "destination": "https://crm-nova-acropole.vercel.app/:caminho*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/recepcao",
      "destination": "/recepcao.html"
    },
    {
      "source": "/checkin",
      "destination": "/checkin.html"
    },
    {
      "source": "/validar",
      "destination": "/validar.html"
    },
    {
      "source": "/inscrever",
      "destination": "/checkin.html"
    },
    {
      "source": "/passe",
      "destination": "/passe.html"
    }
  ]
}
